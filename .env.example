# ---- Server ----
PORT=8080
# DSN MySQL/MariaDB (go-sql-driver). XAMPP lokal: user operan / password operan.
DATABASE_URL=operan:operan@tcp(127.0.0.1:3306)/operan
JWT_SECRET=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Jakarta
# Origin Flutter Web, pisahkan dengan koma. localhost:* selalu diizinkan untuk development.
CORS_ORIGINS=http://localhost:5000
# Alamat backend untuk tools agent Flow 5. Pakai IP (127.0.0.1), bukan "localhost": komponen API Request menolak host tanpa TLD.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---- AI ----
# true = pakai mock deterministik (tanpa Langflow / tanpa API key)
LANGFLOW_MOCK=true
STT_MOCK=true

LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
FLOW_ID_EXTRACT_VOICE=
FLOW_ID_HANDOVER=
FLOW_ID_TREND=
FLOW_ID_DOCTOR_REPORT=
FLOW_ID_ASK_HISTORY=

# Token statis yang dipasang di komponen API Request Langflow (header X-Internal-Token).
INTERNAL_TOOL_TOKEN=change-me

# Speech-to-text. gemini = Google AI Studio (pakai API key yang sama dengan LLM di Langflow).
STT_PROVIDER=gemini
STT_API_KEY=
STT_MODEL=gemini-3.1-flash-lite-preview
STT_BASE_URL=

# Push notification (ditunda untuk MVP)
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Seed
SEED_PASSWORD=operan123
