{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow 2 handover_summary output",
  "type": "object",
  "required": [
    "summary",
    "pending_items",
    "watch_items"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watch_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
