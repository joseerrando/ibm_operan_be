{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow 3 trend_analysis output",
  "type": "object",
  "required": [
    "alerts"
  ],
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "perhatian",
              "penting"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
